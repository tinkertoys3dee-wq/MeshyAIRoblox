NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Attach Railway PostgreSQL in production. Development falls back to memory.
DATABASE_URL=
DATABASE_SSL=true

MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai
MESHY_POLL_INTERVAL_MS=5000
MESHY_TASK_TIMEOUT_MS=900000

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_CREATOR_TYPE=group
ROBLOX_CREATOR_ID=
ROBLOX_SHARED_SECRET=
ROBLOX_ASSET_TIMEOUT_MS=180000

TARGET_TRIANGLES=3600
MAX_TRIANGLES=3999
MAX_VERTICES=3999
MAX_TEXTURE_SIZE=2048
MAX_MODEL_BYTES=19500000
MAX_CONCURRENT_JOBS=4

# Never enable provider mocks in a public deployment.
MOCK_PROVIDERS=false
